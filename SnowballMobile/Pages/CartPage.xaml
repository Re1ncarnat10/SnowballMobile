<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SnowballMobile.PageModels"
             x:Class="SnowballMobile.Pages.CartPage"
             x:DataType="vm:CartPageModel"
             Title="Koszyk">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            <Label Text="Twój koszyk"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <CollectionView ItemsSource="{Binding CartSummary.Items}" IsVisible="{Binding CartSummary}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="10" Margin="0,5" BorderColor="LightGray" CornerRadius="10">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" />
                                <Label Text="Ilość: {Binding Quantity}" FontSize="14" />
                                <Label Text="Cena: {Binding Price}" FontSize="14" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Suma: "
                   FontSize="18"
                   FontAttributes="Bold"
                   HorizontalOptions="End">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Suma: " />
                        <Span Text="{Binding CartSummary.TotalPrice}" FontAttributes="Bold" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>