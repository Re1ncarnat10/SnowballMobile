<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SnowballMobile.PageModels"
             x:Class="SnowballMobile.Pages.LoginPage"
             x:DataType="vm:LoginPageModel"
             Title="Logowanie">
    <VerticalStackLayout Padding="30" Spacing="15">
        <Entry Placeholder="Email" Text="{Binding Email}" Keyboard="Email"/>
        <Entry Placeholder="Hasło" Text="{Binding Password}" IsPassword="True"/>
        <Button Text="Zaloguj" Command="{Binding LoginCommand}" />
        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"/>
        <Label Text="{Binding ErrorMessage}" TextColor="Red"/>
    </VerticalStackLayout>
</ContentPage>