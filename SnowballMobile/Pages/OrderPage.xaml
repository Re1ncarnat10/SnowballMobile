<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SnowballMobile.PageModels"
             x:Class="SnowballMobile.Pages.OrderPage"
             x:DataType="vm:OrdersPageModel"
             Title="Zamówienia">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            <Label Text="Twoje zamówienia"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <CollectionView ItemsSource="{Binding Orders}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="10" Margin="0,5" BorderColor="LightGray" CornerRadius="10">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="Numer zamówienia: {Binding Id}" FontSize="16" FontAttributes="Bold" />
                                <Label Text="Data: {Binding CreatedAt}" FontSize="14" />
                                <Label Text="Suma: {Binding TotalPrice}" FontSize="14" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>