<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SnowballMobile.Pages.OrderPage"
             Title="Zamówienia">

    <ScrollView>
        <StackLayout Padding="10">
            <Label Text="Twoje zamówienia" FontAttributes="Bold" FontSize="24" HorizontalOptions="Center"/>

            <CollectionView ItemsSource="{Binding Orders}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BorderColor="LightGray" CornerRadius="10" Padding="10" Margin="5">
                            <StackLayout>
                                <Label Text="{Binding OrderDate, StringFormat='Data: {0:dd.MM.yyyy HH:mm}'}" FontAttributes="Bold"/>
                                <Label Text="{Binding TotalPrice, StringFormat='Razem: {0:C}'}" />

                                <Label Text="Produkty:" FontAttributes="Bold" Margin="0,10,0,5"/>

                                <!-- Display nested snowballs -->
                                <CollectionView ItemsSource="{Binding Snowballs}">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <StackLayout Orientation="Horizontal" Spacing="10" Margin="0,5">
                                                <Image Source="{Binding Image}" WidthRequest="50" HeightRequest="50" />
                                                <StackLayout>
                                                    <Label Text="{Binding Name}" FontAttributes="Bold" />
                                                    <Label Text="{Binding Description}" FontSize="12" />
                                                    <Label Text="{Binding Price, StringFormat='Cena: {0:C}'}" FontSize="12" />
                                                </StackLayout>
                                            </StackLayout>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>

                            </StackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </StackLayout>
    </ScrollView>
</ContentPage>
