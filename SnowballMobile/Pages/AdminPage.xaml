<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SnowballMobile.PageModels"
             xmlns:model="clr-namespace:SnowballMobile.Models"
             x:Class="SnowballMobile.Pages.AdminPage"
             x:DataType="vm:AdminPanelPageModel"
             Title="Panel administratora">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="Panel administratora" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <!-- Komunikat -->
            <Label Text="{Binding Message}" TextColor="Red" IsVisible="{Binding Message, Converter={StaticResource NullToTextConverter}}" />

            <!-- Formularz dodawania/edycji -->
            <Border Stroke="LightGray" StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10"/>
                </Border.StrokeShape>
                <VerticalStackLayout Padding="15" Spacing="10">
                    <Label Text="{Binding EditingId, Converter={StaticResource NullToTextConverter}, 
                     ConverterParameter='Edytuj śnieżkę;Dodaj nową śnieżkę'}" 
                           FontSize="18" FontAttributes="Bold" />

                    <Entry Placeholder="Nazwa" Text="{Binding FormData.Name}" />
                    <Entry Placeholder="Opis" Text="{Binding FormData.Description}" />
                    <Entry Placeholder="Cena" Text="{Binding FormData.Price}" Keyboard="Numeric" />

                    <Button Text="Wybierz plik obrazu"
                            Command="{Binding PickImageCommand}" 
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
                    <Label Text="{Binding SelectedImageFileName}" FontSize="12" TextColor="Gray" />

                    <HorizontalStackLayout Spacing="10">
                        <Button Text="{Binding EditingId, Converter={StaticResource NullToTextConverter}, 
                ConverterParameter='Zapisz zmiany;Dodaj śnieżkę'}"
                                Command="{Binding SubmitCommand}" 
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />

                        <Button Text="Anuluj" 
                                Command="{Binding ResetFormCommand}" 
                                IsVisible="{Binding EditingId, Converter={StaticResource NullToTextConverter}}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Lista śnieżek -->
           <Label Text="Produkty" FontSize="18" FontAttributes="Bold" />
            <CollectionView ItemsSource="{Binding Snowballs}" Margin="0,10,0,0">
                <CollectionView.EmptyView>
                    <Label Text="Brak śnieżek"
                           FontSize="18"
                           HorizontalOptions="Center"
                           VerticalOptions="CenterAndExpand"
                           TextColor="{StaticResource Gray300}" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="model:SnowballDto">
                        <Frame Padding="12" Margin="0,8" BorderColor="{StaticResource Gray300}" CornerRadius="16" HasShadow="True" BackgroundColor="{AppThemeBinding Light=White, Dark=#232323}">
                            <VerticalStackLayout Spacing="8">
                                <Image Source="{Binding Image}" HeightRequest="80" WidthRequest="80" Aspect="AspectFill" HorizontalOptions="Center">
                                    <Image.Triggers>
                                        <DataTrigger TargetType="Image" Binding="{Binding Image}" Value="{x:Null}">
                                            <Setter Property="Source" Value="snowball.png" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Image" Binding="{Binding Image}" Value="">
                                            <Setter Property="Source" Value="snowball.png" />
                                        </DataTrigger>
                                    </Image.Triggers>
                                </Image>
                                <Label Text="{Binding Name}" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                                <Label Text="{Binding Description}" FontSize="14" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                                <Label Text="{Binding Price, StringFormat='{}{0:C}'}" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                                <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                                    <Button Text="Edytuj"
                                            Command="{Binding Path=BindingContext.EditCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                            CommandParameter="{Binding .}" />
                                    <Button Text="Usuń"
                                            Command="{Binding Path=BindingContext.DeleteCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                            CommandParameter="{Binding SnowballId}"
                                            BackgroundColor="Red" TextColor="White"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>