<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SnowballMobile.PageModels"
             x:Class="SnowballMobile.Pages.ShopPage"
             x:DataType="vm:ShopPageModel"
             Title="Shop"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}">

    <VerticalStackLayout Padding="24,16" Spacing="18">
        <Label Text="Snowballs"
               FontSize="28"
               FontAttributes="Bold"
               Style="{StaticResource Title2}"
               HorizontalOptions="Center" />

        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Primary}" />

        <CollectionView ItemsSource="{Binding Snowballs}" Margin="0,10,0,0">
            <CollectionView.EmptyView>
                <Label Text="No snowballs available"
                       FontSize="18"
                       HorizontalOptions="Center"
                       VerticalOptions="CenterAndExpand"
                       TextColor="{StaticResource Gray300}" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="{StaticResource Gray300}" StrokeThickness="1" Margin="0,6" BackgroundColor="{AppThemeBinding Light=White, Dark=#232323}" StrokeShape="RoundRectangle 16">
                        <Grid ColumnDefinitions="60,*,Auto" RowDefinitions="Auto,Auto" Padding="12">
                            <Image Source="{Binding Image}" Grid.RowSpan="2" Grid.Column="0" HeightRequest="48" WidthRequest="48" Aspect="AspectFill" VerticalOptions="Center" HorizontalOptions="Center">
                                <Image.Triggers>
                                    <DataTrigger TargetType="Image" Binding="{Binding Image}" Value="">
                                        <Setter Property="Source" Value="snowball.png" /> 
                                    </DataTrigger>
                                </Image.Triggers>
                            </Image>
                            <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" Grid.Column="1" Grid.Row="0" />
                            <Label Text="{Binding Description}" FontSize="14" TextColor="{StaticResource Gray600}" Grid.Column="1" Grid.Row="1" />
                            <Label Text="{Binding Price, StringFormat='{}{0:C}'}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Primary}" Grid.Column="2" Grid.Row="0" VerticalOptions="Start" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>