<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SnowballMobile.PageModels"
             xmlns:model="clr-namespace:SnowballMobile.Models"
             x:Class="SnowballMobile.Pages.ShopPage"
             x:DataType="vm:ShopPageModel"
             x:Name="ShopPageRoot"
             Title="Shop"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="24,16">
        <Label Grid.Row="0"
               Text="Snowballs"
               FontSize="28"
               FontAttributes="Bold"
               Style="{StaticResource Title2}"
               HorizontalOptions="Center" />

        <Entry Grid.Row="1"
               Placeholder="Wyszukaj śnieżkę..."
               Text="{Binding SearchText, Mode=TwoWay}"
               ClearButtonVisibility="WhileEditing"
               ReturnType="Search" />

        <ActivityIndicator Grid.Row="2"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           Color="{StaticResource Primary}" />

        <CollectionView Grid.Row="3"
                        ItemsSource="{Binding Snowballs}"
                        Margin="0,10,0,0"
                        SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="No snowballs available"
                       FontSize="18"
                       HorizontalOptions="Center"
                       VerticalOptions="CenterAndExpand"
                       TextColor="{StaticResource Gray300}" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="model:SnowballDto">
                    <Frame Padding="12" Margin="0,8" BorderColor="{StaticResource Gray300}" CornerRadius="16" HasShadow="True" IsEnabled="True" InputTransparent="False" BackgroundColor="{AppThemeBinding Light=White, Dark=#232323}">
                        <VerticalStackLayout Spacing="8">
                            <Image Source="{Binding Image}" HeightRequest="80" WidthRequest="80" Aspect="AspectFill" HorizontalOptions="Center">
                                <Image.Triggers>
                                    <DataTrigger TargetType="Image" Binding="{Binding Image}" Value="{x:Null}">
                                        <Setter Property="Source" Value="snowball.png" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Image" Binding="{Binding Image}" Value="">
                                        <Setter Property="Source" Value="snowball.png" />
                                    </DataTrigger>
                                </Image.Triggers>
                            </Image>

                            <Label Text="{Binding Name}"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   TextColor="{AppThemeBinding Light=Black, Dark=White}" />

                            <Label Text="{Binding Description}"
                                   FontSize="14"
                                   HorizontalOptions="Center"
                                   TextColor="{AppThemeBinding Light=Black, Dark=White}" />

                            <Label Text="{Binding Price, StringFormat='{}{0:C}'}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   TextColor="{AppThemeBinding Light=Black, Dark=White}" />

                            <Button Text="Dodaj do koszyka"
                                    Command="{Binding BindingContext.AddToCartCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                    CommandParameter="{Binding .}" 
                                    IsVisible="{Binding BindingContext.IsLoggedIn, Source={RelativeSource AncestorType={x:Type ContentPage}}}"/>          
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="4"
                Text="Odśwież"
                Command="{Binding RefreshCommand}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
    </Grid>
</ContentPage>