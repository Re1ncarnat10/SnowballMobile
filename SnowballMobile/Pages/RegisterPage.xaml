<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SnowballMobile.PageModels"
             x:Class="SnowballMobile.Pages.RegisterPage"
             x:DataType="vm:RegisterPageModel"
             Title="Rejestracja">
    <VerticalStackLayout Padding="30" Spacing="15">
        <Entry Placeholder="Imię" Text="{Binding Name}"/>
        <Entry Placeholder="Email" Text="{Binding Email}" Keyboard="Email"/>
        <Entry Placeholder="Hasło" Text="{Binding Password}" IsPassword="True"/>
        <Entry Placeholder="Powtórz hasło" Text="{Binding ConfirmPassword}" IsPassword="True"/>
        <Button Text="Zarejestruj"
                Command="{Binding RegisterCommand}"
                IsEnabled="{Binding IsFormValid}" />
    </VerticalStackLayout>
</ContentPage>